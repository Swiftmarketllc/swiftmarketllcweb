# Swift Market LLC environment contract. This file documents NAMES ONLY.
#
# Rules
# - Never put real values here. This file is committed; real values belong in an
#   uncommitted .env.local or in the hosting provider's secret storage.
# - Anything marked SECRET must never use the NEXT_PUBLIC_ prefix, be logged, or be
#   sent to Client Components. NEXT_PUBLIC_ values are inlined into the browser bundle
#   at build time and cannot be made private afterwards.
# - Keep development, preview/staging and production values separate.
# - TBF = To Be Finalized: the owner/hosting decision has not been made, so the
#   value is intentionally blank. Do not guess it.
#
# Current behavior: with every value below blank/false, enquiry submission is
# disabled and POST /api/enquiry answers 503. Nothing is sent or stored.

# ---------------------------------------------------------------- site
# Verified production origin, no trailing slash (for example https://example.com).
# Used for canonical URLs, sitemap, robots and the enquiry Origin check.
# TBF: do not invent a domain; localhost must never be used in production.
SITE_ORIGIN=

# ---------------------------------------------------------------- enquiry: abuse controls
# SECRET. At least 32 random characters. Keys the HMAC used for payload
# fingerprints and opaque client identity. Rotating it resets duplicate detection.
ENQUIRY_FINGERPRINT_SECRET=
# Name of the request header the hosting platform sets to the real client IP
# (for example x-forwarded-for, x-real-ip). It must be one the platform overwrites,
# never a client-supplied header. TBF per hosting provider.
ENQUIRY_TRUSTED_IP_HEADER=

# ---------------------------------------------------------------- database (lead persistence)
# SECRET. Connection string for the persistent enquiry/lead store. TBF: engine and
# host are not chosen. Use a least-privilege application role, not an owner role.
DATABASE_URL=

# ---------------------------------------------------------------- rate limiting
# SECRET. Connection URL for the shared, persistent rate-limit and idempotency store.
# An in-memory store is not acceptable in production (multi-instance hosting).
RATE_LIMIT_STORE_URL=
# SECRET. Token/password for the store above, if the provider uses a separate one.
RATE_LIMIT_STORE_TOKEN=

# ---------------------------------------------------------------- email (Hostinger-compatible SMTP)
# Enabling SMTP configuration does NOT by itself enable public enquiry submission.
ENQUIRY_SMTP_ENABLED=false
# Copy verified account settings only; do not guess values.
# ENQUIRY_SMTP_HOST=
# ENQUIRY_SMTP_PORT=
# tls (implicit TLS) or starttls (mandatory upgrade)
# ENQUIRY_SMTP_SECURITY=
# ENQUIRY_SMTP_USER=
# SECRET.
# ENQUIRY_SMTP_PASSWORD=
# Owner-verified sender mailbox; not inferred from the recipient.
# ENQUIRY_SMTP_FROM=
# Owner-confirmed recipient. This does not establish sending credentials.
ENQUIRY_RECIPIENT=info@swiftmarketllc.com
# Visitor acknowledgement email (doc 00 MVP-LEAD-001). Off until the template and
# privacy wording are approved.
ENQUIRY_ACKNOWLEDGEMENT_ENABLED=false

# ---------------------------------------------------------------- attachments (Enterprise form)
# Off until type/size limits, scanning and storage are approved (doc 00 section 13).
ENQUIRY_ATTACHMENTS_ENABLED=false
# SECRET. Private object-storage location for uploaded files. TBF.
ENQUIRY_ATTACHMENT_STORAGE_URL=
# Maximum upload size in bytes, once approved.
ENQUIRY_ATTACHMENT_MAX_BYTES=

# ---------------------------------------------------------------- admin / lead operations
# SECRET. At least 32 random characters. Signs admin sessions. TBF until the admin
# approach (doc 00 MVP-ADM-001) is chosen.
ADMIN_SESSION_SECRET=
# Comma-separated operator email addresses allowed to sign in (least privilege).
ADMIN_ALLOWED_EMAILS=

# ---------------------------------------------------------------- analytics (consent-aware)
# Public identifiers only (not secrets). Loaded only after a consent policy is approved.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------- observability
# SECRET. Error-reporting DSN. TBF: provider not chosen.
ERROR_MONITORING_DSN=
